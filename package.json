{
  "name": "flash2svg",
  "version": "4.1.0",
  "description": "Animated SVG exporter for Adobe Animate (SMIL, CSS and JS-player output)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "flash2svg": "./dist/cli/flash2svg.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit && svelte-check --tsgo --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs",
    "e2e:panel": "node scripts/e2e-panel.mjs",
    "package": "node scripts/package-zxp.mjs",
    "dev:install": "node scripts/dev-install.mjs",
    "format": "prettier --write \"src/**/*.{ts,svelte,css}\" \"scripts/**/*.{mjs,ts}\" \"tests/**/*.ts\" \"docs/guide/**/*.{mjs,js,css}\""
  },
  "devDependencies": {
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@lottie-animation-community/lottie-specs": "^0.3.2",
    "@lottiefiles/dotlottie-web": "^0.82.0",
    "@resvg/resvg-js": "^2.6.2",
    "@resvg/resvg-wasm": "^2.6.2",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "ajv": "^8.20.0",
    "canvaskit-wasm": "^0.42.0",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "harfbuzzjs": "^1.6.4",
    "libopus-wasm": "^0.4.1",
    "lottie-web": "^5.13.0",
    "marked": "^18.1.2",
    "mpg123-decoder": "^1.0.3",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "shiki": "^4.5.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wasm-media-encoders": "^0.7.0",
    "woff2-encoder": "^2.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
